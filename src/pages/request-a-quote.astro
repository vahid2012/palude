---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, IMAGES, CATEGORIES } from '../data/site.ts';

const title = 'Request a Quote — Iranian Export Sourcing RFQ | Palude';
const description =
  'Request a sourcing quote for Iranian saffron, Persian carpets, pistachios, dates, dried fruits, travertine, marble, bitumen, polyethylene, methanol, urea or almonds. Submit your product, quantity, destination and Incoterms for a one-business-day response.';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  url: `${SITE.url}/request-a-quote/`,
  description,
  mainEntity: {
    '@type': 'Organization',
    name: SITE.name,
    telephone: SITE.phoneE164,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Urmia',
      addressRegion: 'West Azerbaijan',
      addressCountry: 'IR',
    },
  },
};
---

<Layout title={title} description={description} jsonLd={contactSchema}>
  <Breadcrumbs items={[{ label: 'Request a Quote', href: '/request-a-quote/' }]} />

  <section class="container-wide py-14 sm:py-20">
    <header class="max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent">Request for quote</p>
      <h1 class="font-display text-4xl font-extrabold leading-tight text-foreground text-balance sm:text-5xl">
        Submit your Iranian export sourcing RFQ
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-foreground/80 text-pretty">
        Send us the product, grade, quantity, destination port and Incoterms for the shipment you
        are planning. A sourcing advisor responds within one business day with verified supplier
        options, indicative pricing, and a draft proforma invoice. There are no brokerage fees on
        the buyer side.
      </p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <article class="prose-palude max-w-none">
        <h2>What to include in your RFQ</h2>
        <p>
          The fastest route to a useful first response is a complete RFQ. The five fields below are
          the minimum we need to return a draft proforma; the more detail you add, the more precise
          the proforma will be.
        </p>
        <ul>
          <li><strong>Product and grade</strong> — for example, Super Negin saffron, 9x12 hand-knotted Tabriz rug, Fandoghi pistachio 28-30 closed-mouth, Mazafati dates Bam-origin layered, bitumen 60/70 in drums, polyethylene LLDPE film grade. If you are unsure of the grade, describe the application and we will recommend one.</li>
          <li><strong>Quantity</strong> — the estimated volume or order quantity, in kilograms, metric tons, pieces, or containers. Indicative quantities are fine for the first quote; the contract will fix the final quantity.</li>
          <li><strong>Destination</strong> — the destination country and port (or city, for overland DAP shipments). The destination determines the applicable tariff, the certification requirements, and the routing.</li>
          <li><strong>Incoterms</strong> — your preferred Incoterms (FOB, CFR, CIF, DAP). If you are unsure, we will recommend the term that best fits your logistics capability. See our <a href="/shipping-and-logistics/">shipping and logistics guide</a> for the Incoterms comparison.</li>
          <li><strong>Certification requirements</strong> — any certificates your destination or tender requires (ISO 3632, HACCP, halal, EU phytosanitary, EAC, pre-shipment inspection). Our <a href="/certifications/">certifications page</a> lists the standard set by vertical.</li>
        </ul>
        <p>
          You can submit the RFQ through the form on this page, or directly through WhatsApp,
          Telegram or email — whichever channel your team prefers. The form below is a structured
          way to capture the five fields; the messaging channels are faster for a conversational
          first exchange.
        </p>

        <h2>What happens after you submit</h2>
        <p>
          Within one business day of receiving your RFQ, a sourcing advisor picks up the file and
          responds with one of three outcomes: a draft proforma invoice with verified supplier
          options and indicative pricing; a clarifying question if a field is ambiguous; or a
          recommendation to revise the spec if the request is not serviceable as stated. The
          advisor stays on the file through the sample stage, the contract, the production
          supervision, the documentation assembly and the shipment — the same desk handles the
          engagement end to end.
        </p>
        <p>
          For first-time relationships, the standard sequence after RFQ approval is: sample
          dispatch with the relevant lab certificate, sample approval (with optional independent
          re-test at a destination laboratory), fixed-price proforma and contract, production and
          quality-control supervision, document check at origin, and shipment. The
          <a href="/blog/iran-export-documentation-checklist/">documentation checklist</a> and the
          <a href="/faq/">B2B FAQ</a> cover the sequence in detail.
        </p>
        <p>
          If you are ready to move beyond the RFQ and want to talk directly, the
          <a href="/contact/">contact page</a> lists every direct channel — phone, WhatsApp,
          Telegram and Instagram — and the business hours we monitor them.
        </p>
      </article>

      <div>
        <div class="overflow-hidden rounded-2xl border border-border bg-background p-6 shadow-sm sm:p-8">
          <h2 class="font-display text-lg font-bold text-foreground">RFQ form</h2>
          <p class="mt-1.5 text-sm text-muted-foreground">Fields marked with * are required. We respond within one business day.</p>

          <form id="rfq-form" class="mt-6 space-y-5" novalidate>
            <div>
              <label for="rfq-name" class="block text-sm font-medium text-foreground">Full name *</label>
              <input id="rfq-name" name="name" type="text" required autocomplete="name"
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            </div>
            <div>
              <label for="rfq-company" class="block text-sm font-medium text-foreground">Company</label>
              <input id="rfq-company" name="company" type="text" autocomplete="organization"
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            </div>
            <div>
              <label for="rfq-email" class="block text-sm font-medium text-foreground">Email *</label>
              <input id="rfq-email" name="email" type="email" required autocomplete="email"
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            </div>
            <div>
              <label for="rfq-product" class="block text-sm font-medium text-foreground">Product and grade *</label>
              <select id="rfq-product" name="product" required
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                <option value="">Select a product vertical…</option>
                {CATEGORIES.map((c) => (
                  <option value={c.label}>{c.label}</option>
                ))}
                <option value="Persian Carpet">Persian Carpet</option>
                <option value="Other / not listed">Other / not listed</option>
              </select>
            </div>
            <div>
              <label for="rfq-quantity" class="block text-sm font-medium text-foreground">Quantity / volume *</label>
              <input id="rfq-quantity" name="quantity" type="text" required placeholder="e.g. 500 kg, 20 MT, 1x20ft container"
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            </div>
            <div>
              <label for="rfq-destination" class="block text-sm font-medium text-foreground">Destination country and port *</label>
              <input id="rfq-destination" name="destination" type="text" required placeholder="e.g. Hamburg, Germany"
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            </div>
            <div>
              <label for="rfq-incoterm" class="block text-sm font-medium text-foreground">Preferred Incoterms</label>
              <select id="rfq-incoterm" name="incoterm"
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                <option value="">Select Incoterms…</option>
                <option value="FOB">FOB — Free On Board</option>
                <option value="CFR">CFR — Cost and Freight</option>
                <option value="CIF">CIF — Cost, Insurance and Freight</option>
                <option value="DAP">DAP — Delivered at Place</option>
                <option value="Not sure">Not sure — please recommend</option>
              </select>
            </div>
            <div>
              <label for="rfq-message" class="block text-sm font-medium text-foreground">Additional requirements</label>
              <textarea id="rfq-message" name="message" rows="4" placeholder="Certifications, lead time, packaging, target price…"
                class="mt-1.5 block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-sm transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
            </div>
            <button type="submit" class="w-full rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-all hover:bg-primary/90 hover:shadow">
              Submit RFQ
            </button>
            <p id="rfq-status" class="hidden rounded-lg bg-secondary px-4 py-3 text-sm text-foreground" role="status" aria-live="polite"></p>
          </form>

          <div class="mt-6 border-t border-border pt-5">
            <p class="text-sm text-muted-foreground">Prefer to talk directly? Reach the desk on:</p>
            <ul class="mt-3 space-y-1.5 text-sm">
              <li><a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" class="font-medium text-primary hover:underline">WhatsApp: {SITE.phoneDisplay}</a></li>
              <li><a href={`https://t.me/${SITE.telegram}`} target="_blank" rel="noopener" class="font-medium text-primary hover:underline">Telegram: {SITE.phoneDisplay}</a></li>
              <li><a href={`tel:${SITE.phoneE164}`} class="font-medium text-primary hover:underline">Phone: {SITE.phoneDisplay}</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('rfq-form');
    var status = document.getElementById('rfq-status');
    if (!form || !status) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = 'Please complete the required fields (name, email, product, quantity, destination).';
        status.classList.remove('hidden');
        status.classList.add('bg-secondary');
        return;
      }
      var data = new FormData(form);
      var product = data.get('product') || '';
      var quantity = data.get('quantity') || '';
      var destination = data.get('destination') || '';
      var incoterm = data.get('incoterm') || 'Not specified';
      var name = data.get('name') || '';
      var email = data.get('email') || '';
      var body = 'Name: ' + name + '\nEmail: ' + email +
        '\nProduct: ' + product + '\nQuantity: ' + quantity +
        '\nDestination: ' + destination + '\nIncoterms: ' + incoterm +
        '\n\n' + (data.get('message') || '');
      var subject = 'RFQ — ' + product + ' / ' + quantity + ' / ' + destination;
      var mailto = 'mailto:info@palude.ir?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      window.location.href = mailto;
      status.textContent = 'Thank you. Your email client should now open with your RFQ pre-filled. If it does not, email info@palude.ir directly or message us on WhatsApp.';
      status.classList.remove('hidden');
      form.reset();
    });
  })();
</script>
