---
import { SITE, MAIN_NAV } from '../data/site.ts';
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/85 backdrop-blur-md">
  <div class="container-wide flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} homepage`}>
      <Logo />
      <span class="font-display text-lg font-extrabold tracking-tight text-foreground">
        {SITE.name}<span class="text-accent">.ir</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {MAIN_NAV.slice(0, 7).map((item) => (
        <a
          href={item.href}
          class="rounded-md px-3 py-2 text-sm font-medium text-foreground/75 transition-colors hover:bg-secondary hover:text-foreground"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/blog/"
        class="rounded-md px-3 py-2 text-sm font-medium text-foreground/75 transition-colors hover:bg-secondary hover:text-foreground"
      >
        Blog
      </a>
      <a
        href="/about/"
        class="rounded-md px-3 py-2 text-sm font-medium text-foreground/75 transition-colors hover:bg-secondary hover:text-foreground"
      >
        About
      </a>
      <a
        href="/request-a-quote/"
        class="ml-1 rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-all hover:bg-primary/90 hover:shadow"
      >
        Request a Quote
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-foreground lg:hidden"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-border bg-background lg:hidden" aria-label="Mobile">
    <div class="container-wide grid gap-1 py-3">
      {MAIN_NAV.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-3 py-2.5 text-sm font-medium text-foreground/80 transition-colors hover:bg-secondary"
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
