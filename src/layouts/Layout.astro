---
import '@/styles/globals.css';
import SeoMeta from '../components/SeoMeta.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { SITE } from '../data/site.ts';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonLd?: object | object[];
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  jsonLd,
  publishedTime,
  modifiedTime,
  author,
  showHeader = true,
  showFooter = true,
} = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  foundingDate: String(SITE.founded),
  areaServed: 'Worldwide',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Urmia',
    addressRegion: 'West Azerbaijan',
    addressCountry: 'IR',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: SITE.phoneE164,
      availableLanguage: ['English', 'Persian'],
    },
  ],
  sameAs: [SITE.instagramUrl],
};

const allSchemas = jsonLd
  ? Array.isArray(jsonLd)
    ? [organizationSchema, ...jsonLd]
    : [organizationSchema, jsonLd]
  : [organizationSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <SeoMeta
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      jsonLd={allSchemas}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
    />
  </head>
  <body class="flex min-h-screen flex-col bg-background">
    {showHeader && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {showFooter && <Footer />}
    <FloatingContact />
  </body>
</html>
