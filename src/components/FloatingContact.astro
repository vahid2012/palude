---
import { SITE } from '../data/site.ts';

const channels = [
  {
    label: `Call ${SITE.phoneDisplay}`,
    href: `tel:${SITE.phoneE164}`,
    icon: 'phone',
    class: 'bg-primary',
    external: false,
  },
  {
    label: `WhatsApp ${SITE.phoneDisplay}`,
    href: `https://wa.me/${SITE.whatsapp}`,
    icon: 'whatsapp',
    class: 'bg-[#25D366]',
    external: true,
  },
  {
    label: `Telegram ${SITE.phoneDisplay}`,
    href: `https://t.me/${SITE.telegram}`,
    icon: 'telegram',
    class: 'bg-[#229ED9]',
    external: true,
  },
  {
    label: `Instagram @${SITE.instagram}`,
    href: SITE.instagramUrl,
    icon: 'instagram',
    class: 'bg-gradient-to-br from-[#F58529] via-[#DD2A7B] to-[#8134AF]',
    external: true,
  },
];
---

<aside
  id="contact-widget"
  class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-2.5"
  aria-label="Quick contact"
>
  <div
    id="contact-panel"
    class="hidden w-64 flex-col gap-2 rounded-2xl border border-border bg-background p-3 shadow-xl"
  >
    <div class="px-2 pb-1 pt-1">
      <p class="font-display text-sm font-bold text-foreground">Talk to a sourcing advisor</p>
      <p class="mt-0.5 text-xs text-muted-foreground">{SITE.address}</p>
    </div>
    {channels.map((c) => (
      <a
        href={c.href}
        class="group flex items-center gap-3 rounded-xl px-2.5 py-2 text-sm font-medium text-foreground transition-colors hover:bg-secondary"
        aria-label={c.label}
        target={c.external ? '_blank' : undefined}
        rel={c.external ? 'noopener' : undefined}
      >
        <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white ${c.class}`}>
          {c.icon === 'phone' && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          )}
          {c.icon === 'whatsapp' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43-.14-.01-.31-.01-.48-.01s-.43.06-.66.31c-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
          )}
          {c.icon === 'telegram' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.94 4.3l-3.27 15.42c-.25 1.09-.9 1.36-1.82.85l-5.03-3.71-2.43 2.34c-.27.27-.5.5-1.02.5l.36-5.12 9.33-8.43c.41-.36-.09-.56-.63-.2L5.16 13.06 1.4 11.88c-.82-.26-.84-.82.17-1.21l19.18-7.39c.68-.25 1.28.16 1.06 1.02z"/></svg>
          )}
          {c.icon === 'instagram' && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          )}
        </span>
        <span class="leading-tight">{c.label}</span>
      </a>
    ))}
  </div>

  <button
    id="contact-toggle"
    type="button"
    class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg transition-transform hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    aria-label="Open contact options"
    aria-expanded="false"
    aria-controls="contact-panel"
  >
    <svg id="contact-icon-closed" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <svg id="contact-icon-open" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</aside>

<script is:inline>
  (function () {
    var toggle = document.getElementById('contact-toggle');
    var panel = document.getElementById('contact-panel');
    var iconClosed = document.getElementById('contact-icon-closed');
    var iconOpen = document.getElementById('contact-icon-open');
    if (!toggle || !panel) return;
    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      panel.classList.toggle('flex', open);
      iconClosed.classList.toggle('hidden', open);
      iconOpen.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close contact options' : 'Open contact options');
    }
    toggle.addEventListener('click', function () {
      setOpen(panel.classList.contains('hidden'));
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>
