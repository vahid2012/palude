---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES } from '../../data/site.ts';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const posts = await getCollection('exports');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const category = CATEGORIES.find((c) => c.href === `/export/${post.slug}/`);

const title = post.data.title;
const description = post.data.description;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.h1,
  description: post.data.description,
  image: post.data.heroImage,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: { '@type': 'Organization', name: 'Palude' },
  publisher: {
    '@type': 'Organization',
    name: 'Palude',
    logo: { '@type': 'ImageObject', url: 'https://palude.ir/favicon.svg' },
  },
  mainEntityOfPage: `https://palude.ir/export/${post.slug}/`,
  articleSection: post.data.category,
  keywords: post.data.keywords.join(', '),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: post.data.h1,
  description: post.data.description,
  category: post.data.category,
  brand: { '@type': 'Brand', name: 'Palude' },
  image: post.data.heroImage,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Palude' },
  },
};

const ogType: 'article' = 'article';
---

<Layout
  title={title}
  description={description}
  canonical={`/export/${post.slug}/`}
  ogImage={post.data.heroImage}
  ogType={ogType}
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.publishDate).toISOString()}
  jsonLd={[articleSchema, productSchema]}
>
  <Breadcrumbs
    items={[
      { label: 'Export', href: '/#export' },
      { label: post.data.breadcrumbName, href: `/export/${post.slug}/` },
    ]}
  />

  <article class="container-wide pt-8">
    <!-- Hero -->
    <header class="mx-auto max-w-3xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent">{post.data.category}</p>
      <h1 class="font-display text-4xl font-extrabold leading-tight text-foreground text-balance sm:text-5xl">
        {post.data.h1}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-foreground/80 text-pretty">
        {post.data.description}
      </p>
    </header>

    <figure class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-border shadow-sm">
      <img
        src={post.data.heroImage}
        alt={post.data.heroAlt}
        class="h-72 w-full object-cover sm:h-96"
        loading="eager"
        width="940"
        height="650"
      />
      <figcaption class="bg-secondary/60 px-4 py-2.5 text-center text-sm text-muted-foreground">
        {post.data.heroAlt}
      </figcaption>
    </figure>

    <!-- Quick spec strip -->
    <dl class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-border bg-background p-4 text-center shadow-sm">
        <dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Origin</dt>
        <dd class="mt-1 font-semibold text-foreground">{post.data.origin}</dd>
      </div>
      <div class="rounded-xl border border-border bg-background p-4 text-center shadow-sm">
        <dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Minimum order</dt>
        <dd class="mt-1 font-semibold text-foreground">{post.data.minOrder}</dd>
      </div>
      <div class="rounded-xl border border-border bg-background p-4 text-center shadow-sm">
        <dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Primary market</dt>
        <dd class="mt-1 font-semibold text-foreground">{post.data.primaryMarket}</dd>
      </div>
    </dl>

    <!-- Body -->
    <div class="container-prose prose-palude mt-12">
      <Content />
    </div>

    <!-- CTA -->
    <div class="container-prose mt-12 rounded-2xl border border-border bg-secondary/50 p-6 text-center sm:p-8">
      <h2 class="font-display text-2xl font-bold text-foreground">Request a quote for this vertical</h2>
      <p class="mt-3 text-foreground/80">
        Share your grade, volume, destination port and certification requirements. A sourcing
        advisor responds within one business day.
      </p>
      <a href="/contact/" class="mt-5 inline-flex rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-all hover:bg-primary/90 hover:shadow">
        Request a sourcing quote
      </a>
    </div>

    <!-- Related verticals -->
    {category && (
      <aside class="container-wide mt-16 border-t border-border pt-12">
        <h2 class="font-display text-2xl font-bold text-foreground">Related Iranian export verticals</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {CATEGORIES.filter((c) => c.slug !== category.slug).slice(0, 3).map((c) => (
            <a href={c.href} class="group flex flex-col overflow-hidden rounded-xl border border-border bg-background shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
              <div class="h-36 overflow-hidden">
                <img src={c.image} alt={c.alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="940" height="650" />
              </div>
              <div class="p-4">
                <h3 class="font-display text-base font-semibold text-foreground">{c.label}</h3>
                <p class="mt-1.5 text-sm text-foreground/70">{c.blurb}</p>
              </div>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>
</Layout>
